---
import ReaderLayout from "../layouts/ReaderLayout.astro";
---

<ReaderLayout title="Unsubscribe">
  <div class="subscribe">
    <p>Enter your email to unsubscribe.</p>

    <form id="unsubscribe-form">
      <input
        type="email"
        id="unsubscribe-email"
        placeholder="Email address"
        required
      />

      <button type="submit">
        Unsubscribe
      </button>
    </form>

    <div class="subscribe-message">
      <p id="unsubscribe-message" style="font-size: 16px;"></p>
    </div>
  </div>

  <script is:inline>
    const unsubscribeForm = document.getElementById("unsubscribe-form");
    const unsubscribeEmail = document.getElementById("unsubscribe-email");
    const unsubscribeMessage = document.getElementById("unsubscribe-message");

    unsubscribeForm.addEventListener("submit", async (event) => {
      console.log("Submit fired");
      event.preventDefault();

      unsubscribeMessage.textContent = "Unsubscribing...";

      try {
        const response = await fetch(
          "https://berriezai-newsletter.dxxzaiamvs.workers.dev/unsubscribe",
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              email: unsubscribeEmail.value,
            }),
          }
        );

        const result = await response.text();
        console.log("Worker response:", result);

        if (response.ok) {
          unsubscribeMessage.textContent =
            "You have unsubscribed successfully.";
          unsubscribeForm.reset();
        } else {
          unsubscribeMessage.textContent =
            "Something went wrong. Please try again.";
        }

      } catch (error) {
        console.error(error);
        unsubscribeMessage.textContent =
          "Could not connect. Please try again later.";
      }
    });
  </script>
</ReaderLayout>