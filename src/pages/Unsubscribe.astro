---
import ReaderLayout from "../layouts/ReaderLayout.astro";
---
<ReaderLayout />
<div class="subscribe">
  <p>Enter your email to unsubcribe.</p>

  <form id="subscribe-form">
    <input
      type="email"
      id="email"
      placeholder="Email address"
      required
    />

    <button type="submit">
      Unsubscribe
    </button>
  </form>
  <div class="subscribe-message">
  <p id="subscribe-message" style="font-size: 16px;"></p></div>
  </div>

<script is:inline>
  const form = document.getElementById("subscribe-form");
  const emailInput = document.getElementById("email");
  const message = document.getElementById("subscribe-message");

  form.addEventListener("submit", async (event) => {
    event.preventDefault();

    message.textContent = "Unsubscribing...";

    try {
      if (url.pathname === "/unsubscribe") {
        const response = await fetch(
          `https://api.resend.com/audiences/${env.RESEND_AUDIENCE_ID}/contacts/${encodeURIComponent(email)}`,
          {
            method: "DELETE",
            headers: {
              Authorization: `Bearer ${env.RESEND_API_KEY}`,
            },
          }
        );

        return new Response(await response.text(), {
          status: response.status,
          headers: {
            ...corsHeaders,
            "Content-Type": "application/json",
          },
        });
      }
      if (response.ok) {
        message.textContent = "You have unsubscribed!";
        form.reset();
      } else {
        message.textContent = "Something went wrong. Please try again.";
}

    } catch (error) {
      message.textContent = "Could not connect. Please try again later.";
    }
  });
</script>
</ReaderLayout>