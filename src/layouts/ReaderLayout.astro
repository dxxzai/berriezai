---
import "../styles/global.css";
import "../styles/epub.css";

const { title } = Astro.props;
---

<html lang="en"> 
<head>
    <title>{title}</title>
    <meta charset="UTF-8">
    <link rel="icon" type="image/x-icon" href="/berriezai/favicon.ico">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
</head>

<body>
<main class="reader">

    <article class="chapter">
    <slot />
    <hr />
    </article>
</main>

</body>
</html>
